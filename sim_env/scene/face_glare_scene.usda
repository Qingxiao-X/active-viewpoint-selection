def PhysicsScene "physicsScene" (
    prepend apiSchemas = ["PhysxSceneAPI"]
)
{
    vector3f physics:gravityDirection = (0, 0, -1)
    float physics:gravityMagnitude = 9.81
    uniform token physxScene:broadphaseType = "MBP"
    bool physxScene:enableCCD = 1
    bool physxScene:enableGPUDynamics = 0
    bool physxScene:enableStabilization = 0
    uniform token physxScene:solverType = "TGS"
    uint physxScene:timeStepsPerSecond = 60
}

def "World"
{
    def DomeLight "EnvLight"
    {
        color3f inputs:color = (1, 1, 1)
        float inputs:intensity = 260
    }

    def SphereLight "KeyLight"
    {
        float inputs:intensity = 675156
        float inputs:radius = 0.05
        bool treatAsPoint = 0
        double3 xformOp:translate = (1.1233401679954311, 0.0982795299829072, 1.4104241719908024)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Camera "RGBDCamera"
    {
        float2 clippingRange = (0.01, 100)
        float focalLength = 28
        float horizontalAperture = 20.955
        float verticalAperture = 15.71625
        quatd xformOp:orient = (0.5, 0.5, 0.5, 0.5)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.6000000238418579, 0, 1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def Xform "Head" (
        prepend references = @../assets/lee_perry_smith/lee_perry_smith.usd@
    )
    {
        double3 xformOp:translate = (0, 0, 1)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        over "Looks"
        {
            over "Skin"
            {
                over "Shader"
                {
                    float inputs:ior = 1.4
                    float inputs:metallic = 0
                    float inputs:roughness = 0.2
                }
            }
        }
    }

    def Xform "Markers"
    {
        token visibility = "invisible"

        def "Looks"
        {
            def Material "glare"
            {
                token outputs:surface.connect = </World/Markers/Looks/glare/Shader.outputs:surface>

                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (1, 0.75, 0.1)
                    color3f inputs:emissiveColor = (3, 2.25, 0.3)
                    float inputs:roughness = 0.7
                    token outputs:surface
                }
            }

            def Material "clean"
            {
                token outputs:surface.connect = </World/Markers/Looks/clean/Shader.outputs:surface>

                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.55, 0.65, 0.8)
                    color3f inputs:emissiveColor = (0.275, 0.325, 0.4)
                    float inputs:roughness = 0.7
                    token outputs:surface
                }
            }

            def Material "front"
            {
                token outputs:surface.connect = </World/Markers/Looks/front/Shader.outputs:surface>

                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.15, 0.45, 1)
                    color3f inputs:emissiveColor = (0.12, 0.36, 0.8)
                    float inputs:roughness = 0.7
                    token outputs:surface
